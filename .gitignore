# =============================================================================
# Rust / Cargo
# =============================================================================
# Ignore the entire build artifact directory where compiler caches live
/target/

# Backup files generated by cargo under rare crash conditions
**/*.rs.bk
Cargo.lock

# NOTE: Keep Cargo.lock committed if this is an executable/game application.
# It guarantees deterministic dependency versions across builds.

# =============================================================================
# Assets & Resources (Safety Rule)
# =============================================================================
# Explicitly do NOT ignore your audio and art assets
!resources/
!resources/**/*

# =============================================================================
# Operating System Garbage
# =============================================================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
*.desktop

# =============================================================================
# IDEs and Text Editors
# =============================================================================
# Micro editor history tracking files
*~
*.swp

# Visual Studio Code workspace state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.history/
*.code-workspace

# CLion / IntelliJ tracking
.idea/
*.iml

# =============================================================================
# Future Mobile/Android Cross-Compilation (Cargo-NDK & Gradle)
# =============================================================================
.gradle/
/build/
local.properties
*.apk
*.aab
*.so
